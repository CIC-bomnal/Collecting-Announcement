# API 키 (디코딩된 값)
NARA_API_KEY_DECODED=여기에_나라장터_API키_입력
KSTARTUP_API_KEY_DECODED=여기에_K-Startup_API키_입력

# Google Sheets
GOOGLE_SHEET_ID=여기에_스프레드시트_ID_입력
GOOGLE_CREDENTIALS_FILE=./credentials.json

# 검색 범위 (0=당일만, 90=3개월 백필)
SEARCH_DAYS_BACK=0

# 키워드 — 일반 (하나라도 매칭 → 추출)
KEYWORDS=스타트업,창업,창업기획자,벤처,육성,액셀러레이터,엑셀러레이터,엑셀러레이팅,투자,START-UP,사업화,유니콘,임팩트,사회문제,주관사,운영사,운영기관

# 키워드 — 필수 추출 (하나라도 매칭 → 무조건 추출)
MUST_EXTRACT_KEYWORDS=협력기관,수행기관,주관기관,액셀러레이팅,엑셀러레이팅,액셀러레이터,엑셀러레이터

# 키워드 — 끝부분 (제목 맨 끝에 매칭 → 무조건 추출, 띄어쓰기 무관)
END_KEYWORDS=운영용역

# 키워드 — 조건부 (일반/필수/끝부분 키워드 1개 이상 함께 매칭 시에만 추출)
CONDITIONAL_KEYWORDS=소상공인,소셜,활성화

# 필터링
MIN_DAYS_REMAINING=7

# 금지어 (쉼표로 구분, 띄어쓰기 무관 매칭)
EXCLUSION_KEYWORDS=기업모집,참가사모집,참가자모집,참여기업,입주기업,참가사,참가자,참가기업,입주사

# 로그
LOG_LEVEL=INFO
